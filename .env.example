NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/app.sqlite
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
TRUST_PROXY=0
ENABLE_SIMULATOR=false
BACKUP_DIR=./backups
MAX_UPLOAD_BYTES=5242880
# Gemini (primary AI provider): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, comma-separated (later ones are fallbacks); default gemini-3.1-flash-lite,gemini-3.8-flash. Check https://ai.google.dev/gemini-api/docs/models for current names.
GEMINI_MODEL=
# Optional: AI study guides per teacher per day (counted in memory). Default 100.
AI_DAILY_LIMIT=
# Fallback provider. Comma-separated OpenRouter keys; stored on the server, never sent to browsers.
OPENROUTER_API_KEYS=
# Optional, comma-separated; later models are fallbacks. Default: openrouter/free
OPENROUTER_MODELS=
